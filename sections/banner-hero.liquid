{%- comment -%} LCP preload when this section is first (index template). Skips theme editor. {%- endcomment -%}
{%- unless request.design_mode -%}
  {%- if section.index == 1 -%}
    {%- liquid
      assign sd = section.settings.background_desktop
      assign sm = section.settings.background_mobile
    -%}
    {%- if sm != blank and sd != blank and sm != sd -%}
      <link
        rel="preload"
        as="image"
        fetchpriority="high"
        media="(max-width: 768px)"
        href="{{ sm | image_url: width: 800, format: 'webp' }}"
        imagesrcset="{{ sm | image_url: width: 400, format: 'webp' }} 400w, {{ sm | image_url: width: 800, format: 'webp' }} 800w, {{ sm | image_url: width: 1200, format: 'webp' }} 1200w"
        imagesizes="100vw">
      <link
        rel="preload"
        as="image"
        fetchpriority="high"
        media="(min-width: 769px)"
        href="{{ sd | image_url: width: 1600, format: 'webp' }}"
        imagesrcset="{{ sd | image_url: width: 800, format: 'webp' }} 800w, {{ sd | image_url: width: 1200, format: 'webp' }} 1200w, {{ sd | image_url: width: 1600, format: 'webp' }} 1600w, {{ sd | image_url: width: 2200, format: 'webp' }} 2200w"
        imagesizes="100vw">
    {%- elsif sm != blank -%}
      <link
        rel="preload"
        as="image"
        fetchpriority="high"
        media="(max-width: 768px)"
        href="{{ sm | image_url: width: 1200, format: 'webp' }}"
        imagesrcset="{{ sm | image_url: width: 400, format: 'webp' }} 400w, {{ sm | image_url: width: 800, format: 'webp' }} 800w, {{ sm | image_url: width: 1200, format: 'webp' }} 1200w, {{ sm | image_url: width: 1500, format: 'webp' }} 1500w"
        imagesizes="100vw">
    {%- elsif sd != blank -%}
      <link
        rel="preload"
        as="image"
        fetchpriority="high"
        media="(min-width: 769px)"
        href="{{ sd | image_url: width: 1600, format: 'webp' }}"
        imagesrcset="{{ sd | image_url: width: 800, format: 'webp' }} 800w, {{ sd | image_url: width: 1200, format: 'webp' }} 1200w, {{ sd | image_url: width: 1600, format: 'webp' }} 1600w, {{ sd | image_url: width: 2200, format: 'webp' }} 2200w"
        imagesizes="100vw">
    {%- endif -%}
  {%- endif -%}
{%- endunless -%}
{{ 'section-banner-hero.css' | asset_url | stylesheet_tag: preload: true }}
{% render 'banner-hero'
  , section: section %}

{% schema %}
  {
    "name": "t:labels.banner_hero",
    "tag": "section",
    "class": "index-section--hero banner-hero-section",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.banner_hero_one_h1"
      },
      {
        "type": "header",
        "content": "t:labels.background"
      },
      {
        "type": "image_picker",
        "id": "background_desktop",
        "label": "t:labels.background_image_desktop",
        "info": "t:info.banner_hero_default_desktop_bg"
      },
      {
        "type": "image_picker",
        "id": "background_mobile",
        "label": "t:labels.background_image_mobile",
        "info": "t:info.banner_hero_mobile_fallback"
      }, {
        "type": "header",
        "content": "t:labels.content"
      }, {
        "type": "header",
        "content": "t:labels.banner_hero_trust_bar"
      }, {
        "type": "checkbox",
        "id": "show_trust_bar",
        "label": "t:labels.banner_hero_show_trust_bar",
        "default": true
      }, {
        "type": "image_picker",
        "id": "foreground_image",
        "label": "t:labels.image_above_heading",
        "info": "t:info.banner_hero_default_foreground"
      }, {
        "type": "text",
        "id": "lockup_image_alt",
        "label": "t:labels.banner_hero_lockup_alt",
        "info": "t:info.banner_hero_lockup_alt",
        "default": "The Art of Skin — natural skincare routines and products"
      }, {
        "type": "text",
        "id": "heading",
        "label": "t:labels.heading",
        "default": "Results after 1 application."
      }, {
        "type": "richtext",
        "id": "text",
        "label": "t:labels.text",
        "default": "<p>Select one of our award-winning routines crafted for your skin.</p>"
      }, {
        "type": "header",
        "content": "t:labels.banner_hero_social_proof"
      }, {
        "type": "checkbox",
        "id": "show_social_proof",
        "label": "t:labels.banner_hero_show_social_proof",
        "default": true
      }, {
        "type": "range",
        "id": "social_star_count",
        "min": 1,
        "max": 5,
        "step": 1,
        "label": "t:labels.banner_hero_star_count",
        "default": 5,
        "info": "t:info.banner_hero_star_count"
      }, {
        "type": "text",
        "id": "social_rating",
        "label": "t:labels.banner_hero_rating_text",
        "default": "4.9"
      }, {
        "type": "text",
        "id": "social_reviews",
        "label": "t:labels.banner_hero_reviews_text",
        "default": "1,200+ reviews"
      }, {
        "type": "text",
        "id": "social_tagline",
        "label": "t:labels.banner_hero_tagline_text",
        "default": "Results after one application"
      }, {
        "type": "select",
        "id": "content_position",
        "label": "t:labels.content_horizontal_position",
        "info": "t:info.banner_hero_content_position",
        "default": "right",
        "options": [
          {
            "value": "left",
            "label": "t:labels.alignments.left"
          }, {
            "value": "right",
            "label": "t:labels.alignments.right"
          }
        ]
      }, {
        "type": "header",
        "content": "t:labels.button"
      }, {
        "type": "text",
        "id": "button_1_label",
        "label": "t:labels.button_1_text",
        "default": "Find My Routine"
      }, {
        "type": "url",
        "id": "button_1_link",
        "label": "t:labels.button_1_link"
      }, {
        "type": "text",
        "id": "button_2_label",
        "label": "t:labels.button_2_text",
        "default": "Shop All"
      }, {
        "type": "url",
        "id": "button_2_link",
        "label": "t:labels.button_2_link"
      }, {
        "type": "header",
        "content": "t:labels.typography"
      }, {
        "type": "color",
        "id": "heading_color",
        "label": "t:labels.heading_color"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "t:labels.text_color"
      }
    ],
    "blocks": [
      {
        "type": "trust_item",
        "name": "t:labels.banner_hero_trust_item",
        "settings": [
          {
            "type": "text",
            "id": "icon",
            "label": "t:labels.banner_hero_trust_icon",
            "default": "✦"
          }, {
            "type": "text",
            "id": "text",
            "label": "t:labels.text",
            "default": "Natural"
          }
        ]
      }
    ],
    "max_blocks": 8,
    "presets": [
      {
        "name": "t:labels.banner_hero",
        "blocks": [
          {
            "type": "trust_item",
            "settings": {
              "icon": "🌿",
              "text": "Natural"
            }
          }, {
            "type": "trust_item",
            "settings": {
              "icon": "V",
              "text": "Vegan"
            }
          }, {
            "type": "trust_item",
            "settings": {
              "icon": "🐰",
              "text": "Cruelty-Free"
            }
          }, {
            "type": "trust_item",
            "settings": {
              "icon": "🏆",
              "text": "ELLE Winner"
            }
          }
        ]
      }
    ],
    "disabled_on": {
      "groups": ["footer", "header"]
    }
  }
{% endschema %}