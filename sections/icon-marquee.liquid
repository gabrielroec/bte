{%- style -%}
.icon-marquee{height:64px;background:var(--Brand-Glow-Blue,#bbd3dd);overflow:hidden}
.icon-marquee__viewport{width:100%;height:100%;display:flex;align-items:center}
.icon-marquee__track{display:flex;align-items:center;width:max-content;animation:icon-marquee-scroll 26s linear infinite;will-change:transform}
.icon-marquee__list{list-style:none;margin:0;padding:0 40px 0 0;display:flex;align-items:center;gap:40px;flex-shrink:0}
.icon-marquee__item{display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap}
.icon-marquee__icon{width:24px;height:24px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.icon-marquee__icon svg{width:24px;height:24px}
.icon-marquee__text{color:#1c1c1c;font-family:Poppins,sans-serif;font-size:18px;font-weight:700;line-height:100%;letter-spacing:1.08px;text-transform:uppercase}
@keyframes icon-marquee-scroll{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}
@media(prefers-reduced-motion:reduce){.icon-marquee__track{animation:none}}
{%- endstyle -%}

