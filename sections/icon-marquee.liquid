{%- liquid
  assign svg_map_toxin_free = svg_toxin_free
  assign svg_map_vegan_icon = svg_vegan
  assign svg_map_cruelty_free = svg_cruelty_free
  assign svg_map_sustainable_icon = svg_sustainable
  assign svg_map_100natural = svg_100natural
-%}

<section class="icon-marquee" aria-label="Brand highlights">
  <div class="icon-marquee__viewport">
    <div class="icon-marquee__track">
      {%- for i in (1..2) -%}
        <ul class="icon-marquee__list" {% if i == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li class="icon-marquee__item" {{ block.shopify_attributes }}>
              <span class="icon-marquee__icon">
                {%- liquid
                  assign icon_id = block.settings.icon_asset | default: 'toxin-free.svg'
                  if icon_id == 'toxin-free.svg'
                    echo svg_map_toxin_free
                  elsif icon_id == 'vegan-icon.svg'
                    echo svg_map_vegan_icon
                  elsif icon_id == 'cruelty-free.svg'
                    echo svg_map_cruelty_free
                  elsif icon_id == 'Sustainable-icon.svg'
                    echo svg_map_sustainable_icon
                  elsif icon_id == '100natural.svg'
                    echo svg_map_100natural
                  else
                    echo svg_map_toxin_free
                  endif
                -%}
              </span>
              <span class="icon-marquee__text">{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon marquee",
  "tag": "section",
  "class": "icon-marquee-section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Toxin-Free"
        },
        {
          "type": "select",
          "id": "icon_asset",
          "label": "Default icon",
          "default": "toxin-free.svg",
          "options": [
            { "value": "toxin-free.svg", "label": "Toxin-Free" },
            { "value": "vegan-icon.svg", "label": "Vegan" },
            { "value": "cruelty-free.svg", "label": "Cruelty Free" },
            { "value": "Sustainable-icon.svg", "label": "Sustainable" },
            { "value": "100natural.svg", "label": "100% Natural" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Toxin-Free", "icon_asset": "toxin-free.svg" } },
