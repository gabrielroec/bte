{%- comment -%} 
    Performance: WebP CDN images, explicit dimensions (CLS), fetchpriority on LCP img, async decode.
    SEO: single H1, descriptive lockup alt, semantic section, crawlable CTA links. 
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign default_fg = 'AgingSkin-RoutineProductShotv2 1.jpg'
  assign fmt = 'webp'

  assign bg_desktop_pick = s.background_desktop
  assign bg_mobile_pick = s.background_mobile

  assign desktop_is_shopify = false
  if bg_desktop_pick != blank
    assign desktop_is_shopify = true
  endif

  assign img_shopify = blank
  if bg_mobile_pick != blank
    assign img_shopify = bg_mobile_pick
  endif

  assign img_is_shopify = false
  if img_shopify != blank
    assign img_is_shopify = true
  endif

  assign lockup_alt = s.lockup_image_alt | default: 'The Art of Skin — natural skincare routines and products'

  assign b1 = s.button_1_link
  assign b1_ext = false
  if b1 != blank and b1 contains 'http'
    unless b1 contains shop.secure_url
      assign b1_ext = true
    endunless
  endif

  assign b2 = s.button_2_link
  assign b2_ext = false
  if b2 != blank and b2 contains 'http'
    unless b2 contains shop.secure_url
      assign b2_ext = true
    endunless
  endif
-%}

<section
  class="banner-hero"
  {% if s.heading != blank %}
  aria-labelledby="banner-hero-heading-{{ section.id }}"
  {% else %}
  role="region"
  aria-label="{{ lockup_alt | truncate: 80 | escape }}"
  {% endif %}
  {% if s.heading_color != blank or s.text_color != blank %}
  style="{% if s.heading_color != blank %}--bh-heading-color: {{ s.heading_color }};{% endif %}{% if s.text_color != blank %}--bh-text-color: {{ s.text_color }};{% endif %}"
  {% endif %}>
  <div class="banner-hero__stage">
    <div class="banner-hero__media">
      <picture>
        {%- if desktop_is_shopify -%}
          <source
            media="(min-width: 769px)"
            type="image/webp"
            srcset="
              {{ bg_desktop_pick | image_url: width: 800, format: fmt }} 800w,
              {{ bg_desktop_pick | image_url: width: 1200, format: fmt }} 1200w,
              {{ bg_desktop_pick | image_url: width: 1600, format: fmt }} 1600w,
              {{ bg_desktop_pick | image_url: width: 2000, format: fmt }} 2000w,
              {{ bg_desktop_pick | image_url: width: 2600, format: fmt }} 2600w
            "
            sizes="100vw">
        {%- endif -%}

        {%- if img_is_shopify -%}
          <source
            media="(max-width: 768px)"
            type="image/webp"
            srcset="
              {{ img_shopify | image_url: width: 400, format: fmt }} 400w,
              {{ img_shopify | image_url: width: 600, format: fmt }} 600w,
              {{ img_shopify | image_url: width: 800, format: fmt }} 800w,
              {{ img_shopify | image_url: width: 1200, format: fmt }} 1200w
            "
            sizes="100vw">
          <img
            class="banner-hero__img"
            src="{{ img_shopify | image_url: width: 1200, format: fmt }}"
            alt=""
            width="{{ img_shopify.width }}"
            height="{{ img_shopify.height }}"
            loading="eager"
            fetchpriority="high"
            decoding="async">
        {%- elsif desktop_is_shopify -%}
          <img
            class="banner-hero__img"
            src="{{ bg_desktop_pick | image_url: width: 1600, format: fmt }}"
            srcset="
              {{ bg_desktop_pick | image_url: width: 800, format: fmt }} 800w,
              {{ bg_desktop_pick | image_url: width: 1200, format: fmt }} 1200w,
              {{ bg_desktop_pick | image_url: width: 1600, format: fmt }} 1600w,
              {{ bg_desktop_pick | image_url: width: 2000, format: fmt }} 2000w
            "
            sizes="(max-width: 768px) 100vw, min(100vw, 1240px)"
            alt=""
            width="{{ bg_desktop_pick.width }}"
            height="{{ bg_desktop_pick.height }}"
            loading="eager"
            fetchpriority="high"
            decoding="async">
        {%- endif -%}
      </picture>
    </div>

    <div class="banner-hero__container banner-hero__container--{{ s.content_position | default: 'right' }}">
      <div class="banner-hero__content">
        {%- unless s.show_trust_bar == false -%}
          {%- assign has_trust_items = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_item' and block.settings.text != blank -%}
              {%- assign has_trust_items = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if has_trust_items -%}
            <div
              class="banner-hero__trust"
              role="list"
              aria-label="Trust highlights">
              {%- for block in section.blocks -%}
                {%- if block.type == 'trust_item' and block.settings.text != blank -%}
                  <span
                    class="banner-hero__trust-item"
                    role="listitem"
                    {{ block.shopify_attributes }}>
                    {%- if block.settings.icon != blank -%}
                      <span class="banner-hero__trust-icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>
                    {%- endif -%}
                    <span class="banner-hero__trust-text">{{ block.settings.text | escape }}</span>
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endunless -%}

        <div class="banner-hero__figure">
          {%- if s.foreground_image != blank -%}
            {%- assign fg = s.foreground_image -%}
            {%- assign fg_alt = fg.alt | default: lockup_alt -%}
            {{ fg | image_url: width: 560, format: fmt | image_tag: loading: 'lazy', decoding: 'async', class: 'banner-hero__foreground', alt: fg_alt, widths: '200, 360, 480, 560', sizes: '(max-width: 749px) 92vw, 576px'
            }}
          {%- else -%}
            <img
              class="banner-hero__foreground"
              src="{{ default_fg | asset_url }}"
              alt="{{ lockup_alt | escape }}"
              width="280"
              height="70"
              loading="lazy"
              decoding="async">
          {%- endif -%}
        </div>

        <p class="banner-hero__eyebrow">THE ART OF SKIN</p>

        {%- if s.heading != blank -%}
          <h1 class="banner-hero__title" id="banner-hero-heading-{{ section.id }}">{{ s.heading | escape }}</h1>
        {%- endif -%}

        {%- if s.text != blank -%}
          <div class="banner-hero__text rte">{{ s.text }}</div>
        {%- endif -%}

        {%- liquid
          assign show_b1 = false
          if s.button_1_label != blank and b1 != blank
            assign show_b1 = true
          endif
          assign show_b2 = false
          if s.button_2_label != blank and b2 != blank
            assign show_b2 = true
          endif
        -%}
        {%- if show_b1 or show_b2 -%}
          <div
            class="banner-hero__actions"
            role="group"
            aria-label="Call to action">
            {%- if show_b2 -%}
              <a
                href="{{ b2 }}"
                class="btn banner-hero__btn banner-hero__btn--shop-all"
                {% if b2_ext %}
                rel="noopener noreferrer"
                target="_blank"
                {% endif %}>
                {{- s.button_2_label | escape -}}
              </a>
            {%- endif -%}
            {%- if show_b1 -%}
              <a
                href="{{ b1 }}"
                class="btn banner-hero__btn banner-hero__btn--routine"
                {% if b1_ext %}
                rel="noopener noreferrer"
                target="_blank"
                {% endif %}>
                {{- s.button_1_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- unless s.show_social_proof == false -%}
          {%- liquid
            assign star_n = s.social_star_count | default: 5
            if star_n < 1
              assign star_n = 1
            elsif star_n > 5
              assign star_n = 5
            endif
            assign sr_line = ''
            if s.social_rating != blank
              assign sr_line = sr_line | append: 'Rated ' | append: s.social_rating | append: ' out of 5. '
            endif
            if s.social_reviews != blank
              assign sr_line = sr_line | append: s.social_reviews | append: '. '
            endif
            if s.social_tagline != blank
              assign sr_line = sr_line | append: s.social_tagline | append: '.'
            endif
          -%}
          <div class="banner-hero__social">
            {%- if sr_line != blank -%}
              <p class="visually-hidden">{{ sr_line | strip }}</p>
            {%- endif -%}
            <div class="banner-hero__social-row">
              {%- if star_n > 0 -%}
                <span class="banner-hero__social-item banner-hero__stars" aria-hidden="true">
                  {%- for i in (1..star_n) -%}
                    <svg
                      class="banner-hero__star"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="currentColor"
                      focusable="false">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  {%- endfor -%}
                </span>
              {%- endif -%}
              {%- if s.social_rating != blank -%}
                <span class="banner-hero__social-item banner-hero__social-rating">{{ s.social_rating | escape }}</span>
              {%- endif -%}
              {%- if s.social_reviews != blank -%}
                <span class="banner-hero__social-item banner-hero__social-reviews">{{ s.social_reviews | escape }}</span>
              {%- endif -%}
              {%- if s.social_tagline != blank -%}
                <span class="banner-hero__social-item banner-hero__social-tagline">{{ s.social_tagline | escape }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endunless -%}
      </div>
    </div>
  </div>
</section>