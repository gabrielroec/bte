    "faq_3pxWPM": {
      "type": "faq",
      "blocks": {
        "question_iEhB9N": {
          "type": "question",
          "settings": {
            "title": "How does the Try it. Love it. Keep it. program work?",
            "text": "<p>You choose the skincare routine that fits your skin type, we send it to you for free, and you get 14 days to try it. At the end of your trial, you keep what you love and return anything that didn’t work for you. You’ll only be charged for what you decide to keep.</p>"
          }
        },
        "question_8bMbiJ": {
          "type": "question",
          "settings": {
            "title": "Is there any upfront payment?",
            "text": "<p>Nope—nothing upfront. One thing to note is that we do put a hold charge on the card you use. This charge is to verify that the card you use is legitimate. This hold is not a charge. We only charge you after the 14-day trial, and only for the items you choose to keep.</p>"
          }
        },
        "question_EDhMgb": {
          "type": "question",
          "settings": {
            "title": "What if I decide not to keep anything?",
            "text": "<p>No problem at all. Just send the products back and you won’t be charged. </p>"
          }
        },
        "question_hxgrmb": {
          "type": "question",
          "settings": {
            "title": "When does the 14-day trial start?",
            "text": "<p>Your trial starts the day your order is delivered. You’ll have two full weeks to experience the products before making a decision.</p>"
          }
        },
        "question_ERpCVX": {
          "type": "question",
          "settings": {
            "title": "Is shipping free?",
            "text": "<p>Yes—both ways. We cover all shipping costs, including returns.</p>"
          }
        },
        "question_wQmzTB": {
          "type": "question",
          "settings": {
            "title": "Are the products full-size or samples?",
            "text": "<p>They’re all full-size! We believe in giving your skin a true experience, not a one-time sample.</p>"
          }
        },
        "question_pmRtkD": {
          "type": "question",
          "settings": {
            "title": "What if I forget to return the products I don’t want?",
            "text": "<p>We’ll send you a reminder before your trial ends. If we don’t hear from you and the products aren’t returned, we’ll assume you’re keeping the full routine and charge your card accordingly.</p>"
          }
        },
        "question_AqVk8A": {
          "type": "question",
          "settings": {
            "title": "Why are you offering this?",
            "text": "<p>Because we know how hard it is to find skincare that truly works—especially for sensitive skin. We believe in our routines so much, we’re putting our formulas to the test in the best way possible: on your skin, in real life, risk-free.</p>"
          }
        }
      },
