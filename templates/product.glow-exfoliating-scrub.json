    "faq_XpMHc9": {
      "type": "faq",
      "blocks": {
        "question_LdCzpH": {
          "type": "question",
          "settings": {
            "title": "What is the GLOW™ Exfoliating Scrub, and how does it work?",
            "text": "<p>The GLOW™ Exfoliating Scrub is a gentle yet powerful exfoliator that removes dead skin cells, unclogs pores, and reveals brighter, smoother skin.<br/></p>"
          }
        },
        "question_V4wNRq": {
          "type": "question",
          "settings": {
            "title": "What makes the GLOW™ Exfoliating Scrub unique?",
            "text": "<p>It’s 100% natural. Using fine apricot seed powder as a mechanical exfoliant, it exfoliates with nourishing ingredients to leave your skin feeling soft, radiant, and refreshed without harshness.<br/></p>"
          }
        },
        "question_EE96i6": {
          "type": "question",
          "settings": {
            "title": "Is the GLOW™ Exfoliating Scrub safe for sensitive skin?",
            "text": "<p>Yes! It’s formulated to be gentle while still effective, but if you have very sensitive skin, start by using it once a week and adjust as needed.<br/></p>"
          }
        },
        "question_VRhWay": {
          "type": "question",
          "settings": {
            "title": "Does the GLOW™ Exfoliating Scrub help with blackheads?",
            "text": "<p>Absolutely! By unclogging pores and removing buildup, it helps minimize the appearance of blackheads and keeps your skin clear.<br/></p>"
          }
        },
        "question_wMBU9q": {
          "type": "question",
          "settings": {
            "title": "Can the GLOW™ Exfoliating Scrub help with uneven skin tone?",
            "text": "<p>Yes! Regular exfoliation helps fade dark spots and improve skin tone for a more even, glowing complexion.<br/></p>"
          }
        },
        "question_LMCqiE": {
          "type": "question",
          "settings": {
            "title": "What is the Mineral Microbiome Clay Complex™, and what does it do?",
            "text": "<p>This proprietary blend is rich in essential minerals that nourish your skin, helps support its microbiome, and enhance its natural radiance.</p>"
          }
        }
      },
      "block_order": ["question_LdCzpH", "question_V4wNRq", "question_EE96i6", "question_VRhWay", "question_wMBU9q", "question_LMCqiE"],
