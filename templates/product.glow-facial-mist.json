    "faq_XpMHc9": {
      "type": "faq",
      "blocks": {
        "question_LdCzpH": {
          "type": "question",
          "settings": {
            "title": "What is the GLOW™ Facial Mist, and what does it do?",
            "text": "<p>The GLOW™ Facial Mist is a hydrating, refreshing facial spray that soothes, tones, and helps to revitalize your skin for a dewy, healthy glow.</p>"
          }
        },
        "question_V4wNRq": {
          "type": "question",
          "settings": {
            "title": "What are the key benefits of the GLOW™ Facial Mist?",
            "text": "<p>It hydrates, balances your skin’s pH, calms irritation, and gives your complexion a radiant boost—all in one refreshing spritz.</p>"
          }
        },
        "question_EE96i6": {
          "type": "question",
          "settings": {
            "title": "Is the GLOW™ Facial Mist suitable for all skin types?",
            "text": "<p>Absolutely! Whether your skin is dry, oily, sensitive, or combination, this mist is gentle and effective for everyone.</p>"
          }
        },
        "question_VRhWay": {
          "type": "question",
          "settings": {
            "title": "Can I use the GLOW™ Facial Mist as a toner?",
            "text": "<p>Yes! Its balancing and hydrating properties make it a perfect toner to prep your skin before applying serums or moisturizers.</p>"
          }
        },
        "question_wMBU9q": {
          "type": "question",
          "settings": {
            "title": "Can I use the GLOW™ Facial Mist if I have acne-prone skin?",
            "text": "<p>Yes! The natural, non-comedogenic ingredients won’t clog your pores and can help soothe inflammation and irritation.</p>"
          }
        },
        "question_PpqiMW": {
          "type": "question",
          "settings": {
            "title": "Does this facial mist have a scent?",
            "text": "<p>It has a light, refreshing scent from natural floral waters and essential oils, giving you a spa-like experience with every spritz.</p>"
          }
        },
        "question_LMCqiE": {
          "type": "question",
          "settings": {
            "title": "What is the Mineral Microbiome Clay Complex™, and what does it do?",
            "text": "<p>This proprietary blend is rich in essential minerals that nourish your skin, helps support its microbiome, and enhance its natural radiance.</p>"
          }
        }
      },
