    "faq_XpMHc9": {
      "type": "faq",
      "blocks": {
        "question_LdCzpH": {
          "type": "question",
          "settings": {
            "title": "What skin benefits can I expect from the GLOW™ Foaming Cleanser?",
            "text": "<p>GLOW™ Foaming Cleanser deeply cleanses while hydrating and nourishing your skin. It removes dirt, oil, and impurities, helping your skin become soft, balanced, and radiant.</p>"
          }
        },
        "question_V4wNRq": {
          "type": "question",
          "settings": {
            "title": "How does GLOW™ Foaming Cleanser support healthy skin?",
            "text": "<p>This cleanser uses natural ingredients to gently cleanse and restore your skin’s natural moisture barrier, promoting a healthy, glowing complexion.</p>"
          }
        },
        "question_EE96i6": {
          "type": "question",
          "settings": {
            "title": "Is the GLOW™ Foaming Cleanser suitable for acne-prone skin?",
            "text": "<p>Yes! Its gentle formula helps cleanse clogged pores and reduces excess oil without stripping the skin, supporting clearer, healthier-looking skin.</p>"
          }
        },
        "question_VRhWay": {
          "type": "question",
          "settings": {
            "title": "Can the GLOW™ Foaming Cleanser help with hydration?",
            "text": "<p>Absolutely. Unlike harsh cleansers, it includes hydrating ingredients like aloe vera to lock in moisture and keep your skin feeling soft. Pair it with our GLOW™ Daily Moisturizer for a deep hydration.</p>"
          }
        },
        "question_wMBU9q": {
          "type": "question",
          "settings": {
            "title": "What ingredients in the cleanser make it effective?",
            "text": "<p>It’s powered by natural botanicals like aloe vera, essential oils, and gentle plant-based cleansers that remove impurities while nourishing your skin.</p>"
          }
        },
        "question_PpqiMW": {
          "type": "question",
          "settings": {
            "title": "Can this cleanser help with redness or irritation?",
            "text": "<p>Yes! The gentle, natural ingredients help soothe inflammation and redness, making it ideal for sensitive skin.</p>"
          }
        },
        "question_LMCqiE": {
          "type": "question",
          "settings": {
            "title": "What is the Mineral Microbiome Clay Complex™, and what does it do?",
            "text": "<p>This proprietary blend is rich in essential minerals that nourish your skin, helps support its microbiome, and enhance its natural radiance.</p>"
          }
        }
      },
