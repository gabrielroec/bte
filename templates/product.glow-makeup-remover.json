    "faq_XpMHc9": {
      "type": "faq",
      "blocks": {
        "question_LdCzpH": {
          "type": "question",
          "settings": {
            "title": "What is the GLOW™ Makeup Remover, and how does it work?",
            "text": "<p>The GLOW™ Makeup Remover is a gentle yet effective formula that effortlessly dissolves makeup, dirt, and impurities while nourishing your skin.<br/></p>"
          }
        },
        "question_V4wNRq": {
          "type": "question",
          "settings": {
            "title": "Can the GLOW™ Makeup Remover handle waterproof makeup?",
            "text": "<p>We’ve received mixed feedback from our customers on its ability to handle waterproof makeup. Our makeup remover is oil-free, so it works best with non-waterproof makeup.<br/></p>"
          }
        },
        "question_EE96i6": {
          "type": "question",
          "settings": {
            "title": "What makes the GLOW™ Makeup Remover 100% natural?",
            "text": "<p>It’s crafted with plant-based ingredients, free from synthetic chemicals, parabens, and artificial fragrances, ensuring your skin gets only the best.<br/></p>"
          }
        },
        "question_VRhWay": {
          "type": "question",
          "settings": {
            "title": "Is the GLOW™ Makeup Remover suitable for sensitive skin?",
            "text": "<p>Absolutely! Its gentle, non-irritating formula is perfect for sensitive skin, leaving it clean and calm without any redness.<br/></p>"
          }
        },
        "question_wMBU9q": {
          "type": "question",
          "settings": {
            "title": "Does the GLOW™ Makeup Remover strip my skin?",
            "text": "<p>Nope! It’s formulated to cleanse and nourish your skin, preserving its natural moisture barrier while working to remove impurities.<br/></p>"
          }
        },
        "question_PpqiMW": {
          "type": "question",
          "settings": {
            "title": "How does it help with oily or acne-prone skin?",
            "text": "<p>It removes excess oil, makeup, and dirt without clogging pores, which helps to keep breakouts at bay.<br/></p>"
          }
        },
        "question_LMCqiE": {
          "type": "question",
          "settings": {
            "title": "What is the Mineral Microbiome Clay Complex™, and what does it do?",
            "text": "<p>This proprietary blend is rich in essential minerals that nourish your skin, helps support its microbiome, and enhance its natural radiance.</p>"
          }
        }
      },
