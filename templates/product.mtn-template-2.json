    "faq_XpMHc9": {
      "type": "faq",
      "blocks": {
        "question_LdCzpH": {
          "type": "question",
          "settings": {
            "title": "What does the GLOW Facial Mask do.",
            "text": "<p>The GLOW Facial Mask is a natural, triple-clay formula that detoxifies, nourishes, and hydrates your skin, leaving it smooth, refreshed, and radiant.</p>"
          }
        },
        "question_V4wNRq": {
          "type": "question",
          "settings": {
            "title": "What skin types is the mask suitable for?",
            "text": "<p>This mask is suitable for all skin types, including oily, dry, combination, and sensitive skin.<br/><br/></p>"
          }
        },
        "question_EE96i6": {
          "type": "question",
          "settings": {
            "title": "How does the triple clay blend work on the skin?",
            "text": "<p>The triple clays work together to draw out impurities, absorb excess oil, and gently exfoliate, leaving your skin clean, clear, and balanced.</p>"
          }
        },
        "question_VRhWay": {
          "type": "question",
          "settings": {
            "title": "Does the mask help with acne-prone skin?",
            "text": "<p>Yes, the mask’s detoxifying properties help unclog pores, reduce excess oil, and soothe inflammation, making it great for acne-prone skin.</p>"
          }
        },
        "question_wMBU9q": {
          "type": "question",
          "settings": {
            "title": "Does it dry out the skin, or is it hydrating?",
            "text": "<p>Unlike traditional clay masks, the GLOW Facial Mask hydrates while it detoxifies, leaving your skin balanced and refreshed.</p>"
          }
        },
        "question_PpqiMW": {
          "type": "question",
          "settings": {
            "title": "Can I use it in combination with other skincare products?",
            "text": "<p>Yes! Use the mask as a detox step in your routine, followed by a serum and moisturizer to lock in hydration.</p>"
          }
        },
        "question_LMCqiE": {
          "type": "question",
