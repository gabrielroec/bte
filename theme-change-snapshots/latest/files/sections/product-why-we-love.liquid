{{ 'section-product-why-we-love.css' | asset_url | stylesheet_tag }}

<div class="product-why-we-love">
  <div class="page-width product-why-we-love__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-why-we-love__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="product-why-we-love__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Why we love it",
  "tag": "section",
  "class": "section-product-why-we-love",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why We Love It"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We're obsessed with how effortlessly it absorbs, leaving your skin feeling silky without any heavy residue—just a perfectly hydrated glow.</p>"
    }
  ],
  "presets": [
    {
      "name": "Why we love it"
    }
  ]
}
{% endschema %}
