{% # Purchase options — UI própria; dados de Selling Plans (Recharge/apps via Shopify). Opcional: metafield custom.subscription_perks_line %}
{{ 'selling-plans-widget.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign product = section.settings.product | default: product
  assign perks_source = product.metafields.custom.subscription_perks_line.value | default: block.settings.perks_suffix
  assign mode_name = 'purchase_mode_' | append: section.id
  assign pill_name = 'selling_plan_pill_' | append: section.id
  assign form_id = 'product-form-' | append: section.id
  assign has_sp_alloc = false
  for v in product.variants
    if v.selling_plan_allocations.size > 0
      assign has_sp_alloc = true
      break
    endif
  endfor
-%}
{%- if product == blank or product.selling_plan_groups.size == 0 or has_sp_alloc == false -%}
{%- else -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign first_allocation = current_variant.selling_plan_allocations.first -%}
  {%- assign headline_pct = nil -%}
  {%- for allocation in current_variant.selling_plan_allocations -%}
    {%- for adj in allocation.selling_plan.price_adjustments -%}
      {%- if adj.value_type == 'percentage' -%}
        {%- assign headline_pct = adj.value -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if headline_pct -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign perks_display = '' -%}
  {%- if headline_pct -%}
    {%- assign perks_display = 'Save ' | append: headline_pct | append: '%' -%}
    {%- if perks_source != blank -%}
      {%- assign perks_display = perks_display | append: ' · ' | append: perks_source -%}
    {%- endif -%}
  {%- elsif perks_source != blank -%}
    {%- assign perks_display = perks_source -%}
  {%- endif -%}

  <block-selling-plans
    class="selling-plans-widget product-block"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    {% if block.settings.color_primary != blank or block.settings.color_mint != blank or block.settings.color_beige != blank %}
      data-style-vars
    {% endif %}
    style="{% if block.settings.color_primary != blank %}--sp-primary: {{ block.settings.color_primary }};{% endif %}{% if block.settings.color_mint != blank %}--sp-mint: {{ block.settings.color_mint }};{% endif %}{% if block.settings.color_beige != blank %}--sp-beige: {{ block.settings.color_beige }};{% endif %}"
    {{ block.shopify_attributes }}
  >
    <div class="selling-plans-widget__inner" data-selling-plans-root>
      {%- comment -%} Subscribe (primeiro, como no mockup) {%- endcomment -%}
      <div
        class="selling-plans-widget__panel selling-plans-widget__panel--subscribe selling-plans-widget__panel--active"
        data-panel-subscribe
      >
        <div class="selling-plans-widget__row">
          <label class="selling-plans-widget__mode-label" for="sp-mode-sub-{{ section.id }}">
            <input
              type="radio"
              class="selling-plans-widget__mode-input"
              name="{{ mode_name }}"
              id="sp-mode-sub-{{ section.id }}"
              value="subscribe"
              checked
              autocomplete="off"
            >
            <span class="selling-plans-widget__radio-ui" aria-hidden="true"></span>
            <div class="selling-plans-widget__row-main">
              <div class="selling-plans-widget__row-left">
                <div>
                  <div class="selling-plans-widget__title-row">
                    <span class="selling-plans-widget__heading">{{ block.settings.heading_subscribe | escape }}</span>
                    {%- if block.settings.badge_enable -%}
                      <span class="selling-plans-widget__badge">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12 2l2.4 7.4h7.6l-6 4.6 2.3 7-6-4.5-6 4.5 2.3-7-6-4.6h7.6L12 2z"/>
                        </svg>
                        {{ block.settings.badge_text | escape }}
                      </span>
                    {%- endif -%}
                  </div>
                  {%- if perks_display != blank -%}
                    <p class="selling-plans-widget__perks" data-perks-line>{{ perks_display }}</p>
                  {%- else -%}
                    <p class="selling-plans-widget__perks" data-perks-line hidden></p>
                  {%- endif -%}
                </div>
              </div>
              <div class="selling-plans-widget__prices" data-subscribe-prices>
                <span class="selling-plans-widget__price-current" data-subscribe-price>
                  {{- first_allocation.price | money -}}
                </span>
                {%- liquid
                  assign cmp_show = false
                  if first_allocation.compare_at_price and first_allocation.compare_at_price > first_allocation.price
                    assign cmp_show = true
                  endif
                -%}
                <span
                  class="selling-plans-widget__price-compare{% unless cmp_show %} selling-plans-widget__price-compare--hidden{% endunless %}"
                  data-subscribe-compare
                >
                  {%- if cmp_show -%}
                    {{- first_allocation.compare_at_price | money -}}
                  {%- endif -%}
                </span>
              </div>
            </div>
          </label>
        </div>

        <div class="selling-plans-widget__frequency-block" data-frequency-block>
          <span class="selling-plans-widget__deliver-label">{{ block.settings.label_deliver_every | escape }}</span>
          <div class="selling-plans-widget__pills" data-pills-root>
            {%- for allocation in current_variant.selling_plan_allocations -%}
              {%- assign plan = allocation.selling_plan -%}
              {%- liquid
                assign plan_short = plan.name
                assign ov_used = false
                for opt in plan.options
                  assign ov = opt.value | downcase
                  if ov contains 'week' or ov contains 'day' or ov contains 'month'
                    assign plan_short = opt.value | replace: '-', ' '
                    assign ov_used = true
                    break
                  endif
                endfor
                unless ov_used
                  for opt in plan.options
                    assign opt_n = opt.name | downcase
                    if opt_n contains 'frequency' or opt_n contains 'delivery' or opt_n contains 'interval' or opt_n contains 'unit'
                      assign plan_short = opt.value | replace: '-', ' '
                      break
                    endif
                  endfor
                endunless
                if plan_short == plan.name and plan.name contains 'every '
                  assign plan_short = plan.name | split: 'every ' | last | strip
                endif
              -%}
              {%- liquid
                assign pill_cmp_show = false
                if allocation.compare_at_price and allocation.compare_at_price > allocation.price
                  assign pill_cmp_show = true
                endif
              -%}
              <label
                class="selling-plans-widget__pill"
                data-sp-price="{{ allocation.price | money | strip_html | escape }}"
                {% if pill_cmp_show %}
                  data-sp-compare="{{ allocation.compare_at_price | money | strip_html | escape }}"
                {% endif %}
              >
                <input
                  type="radio"
                  class="selling-plans-widget__pill-input"
                  name="{{ pill_name }}"
                  value="{{ plan.id }}"
                  {% if forloop.first %}
                    checked
                  {% endif %}
                  autocomplete="off"
                >
                <span class="selling-plans-widget__pill-text">{{ plan_short | escape }}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
      </div>

      {%- comment -%} One-time {%- endcomment -%}
      <div class="selling-plans-widget__panel selling-plans-widget__panel--onetime" data-panel-onetime>
        <div class="selling-plans-widget__row">
          <label class="selling-plans-widget__mode-label" for="sp-mode-once-{{ section.id }}">
            <input
              type="radio"
              class="selling-plans-widget__mode-input"
              name="{{ mode_name }}"
              id="sp-mode-once-{{ section.id }}"
              value="onetime"
              autocomplete="off"
            >
            <span class="selling-plans-widget__radio-ui" aria-hidden="true"></span>
            <div class="selling-plans-widget__row-main">
              <div class="selling-plans-widget__row-left">
                <span class="selling-plans-widget__heading">{{ block.settings.label_onetime | escape }}</span>
              </div>
              <div class="selling-plans-widget__prices selling-plans-widget__onetime-prices">
                <span class="selling-plans-widget__price-current" data-onetime-price>
                  {{- current_variant.price | money -}}
                </span>
              </div>
            </div>
          </label>
        </div>
      </div>
    </div>

    <input
      type="hidden"
      name="selling_plan"
      form="{{ form_id }}"
      value="{{ first_allocation.selling_plan.id }}"
      class="selling-plans-widget__selling-plan-input"
    >

    <script type="application/json" data-selling-plans-config>
      {
        "modeName": {{ mode_name | json }},
        "pillName": {{ pill_name | json }},
        "labels": {
          "headingSubscribe": {{ block.settings.heading_subscribe | json }},
          "badgeText": {{ block.settings.badge_text | json }},
          "showBadge": {{ block.settings.badge_enable | json }},
          "deliverEvery": {{ block.settings.label_deliver_every | json }},
          "onetime": {{ block.settings.label_onetime | json }},
          "perksSuffix": {{ perks_source | json }}
        },
        "variants": {
          {%- for variant in product.variants -%}
            {%- assign v_disc = nil -%}
            {%- for allocation in variant.selling_plan_allocations -%}
              {%- for adj in allocation.selling_plan.price_adjustments -%}
                {%- if adj.value_type == 'percentage' -%}
                  {%- assign v_disc = adj.value -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if v_disc -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            "{{ variant.id }}": {
              "onetimePrice": {{ variant.price | money | strip_html | json }},
              "discountPercent": {% if v_disc %}{{ v_disc | json }}{% else %}null{% endif %},
              "allocations": [
                {%- for allocation in variant.selling_plan_allocations -%}
                  {%- assign plan = allocation.selling_plan -%}
                  {%- liquid
                    assign plan_short = plan.name
                    assign ov_used = false
                    for opt in plan.options
                      assign ov = opt.value | downcase
                      if ov contains 'week' or ov contains 'day' or ov contains 'month'
                        assign plan_short = opt.value | replace: '-', ' '
                        assign ov_used = true
                        break
                      endif
                    endfor
                    unless ov_used
                      for opt in plan.options
                        assign opt_n = opt.name | downcase
                        if opt_n contains 'frequency' or opt_n contains 'delivery' or opt_n contains 'interval' or opt_n contains 'unit'
                          assign plan_short = opt.value | replace: '-', ' '
                          break
                        endif
                      endfor
                    endunless
                    if plan_short == plan.name and plan.name contains 'every '
                      assign plan_short = plan.name | split: 'every ' | last | strip
                    endif
                  -%}
                  {
                    "planId": {{ plan.id | json }},
                    "shortLabel": {{ plan_short | json }},
                    "price": {{ allocation.price | money | strip_html | json }},
                    "compareAt": {%- if allocation.compare_at_price and allocation.compare_at_price > allocation.price -%}{{ allocation.compare_at_price | money | strip_html | json }}{%- else -%}""{%- endif -%}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        }
      }
    </script>
  </block-selling-plans>

  <script type="module">
    import 'components/block-selling-plans'
  </script>
{%- endif -%}
